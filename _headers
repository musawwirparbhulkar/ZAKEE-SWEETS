# Netlify / Cloudflare Pages / Vercel-style security headers
# This file applies at the edge — the matching meta tags in index.html
# cover cases where the site is served without these headers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google.com https://maps.googleapis.com; frame-src https://www.google.com https://maps.google.com https://maps.app.goo.gl; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me; object-src 'none'
  X-XSS-Protection: 0
  # Only allow the site to be embedded in same-origin iframes if needed

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.webp
  Cache-Control: public, max-age=31536000, immutable
